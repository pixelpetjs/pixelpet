{
  "name": "@pixelpet/vue",
  "version": "0.1.1",
  "description": "Vue 3 integration for @pixelpet/core — a pixel-art desktop pet that sits in a corner of the browser and plays a looping idle animation",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "vue-tsc --noEmit"
  },
  "keywords": [
    "vue",
    "pixel-art",
    "pet",
    "desktop-pet",
    "widget"
  ],
  "license": "MIT",
  "author": "omer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pixelpetjs/pixelpet.git",
    "directory": "packages/vue"
  },
  "homepage": "https://github.com/pixelpetjs/pixelpet/tree/main/packages/vue#readme",
  "bugs": {
    "url": "https://github.com/pixelpetjs/pixelpet/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@pixelpet/core": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vue": "^3.5.13",
    "vue-tsc": "^2.1.10"
  }
}
