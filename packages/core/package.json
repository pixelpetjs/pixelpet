{
  "name": "@pixelpet/core",
  "version": "0.1.1",
  "description": "Framework-agnostic engine for a pixel-art desktop pet that sits in a corner of the browser and plays a looping idle animation",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "pixel-art",
    "pet",
    "desktop-pet",
    "widget"
  ],
  "license": "MIT",
  "author": "omer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pixelpetjs/pixelpet.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/pixelpetjs/pixelpet/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/pixelpetjs/pixelpet/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
