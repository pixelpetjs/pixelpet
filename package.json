{
  "name": "pixelpet-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "PixelPet workspace root",
  "license": "MIT",
  "author": "omer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pixelpetjs/pixelpet.git"
  },
  "homepage": "https://github.com/pixelpetjs/pixelpet#readme",
  "bugs": {
    "url": "https://github.com/pixelpetjs/pixelpet/issues"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* run build",
    "dev": "pnpm --filter vue3-demo dev",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "pnpm -r --filter=./packages/* run typecheck",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=18"
  }
}
